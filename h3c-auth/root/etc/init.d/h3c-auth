#!/bin/sh /etc/rc.common
# H3C Campus Auth - procd service init script

START=99
STOP=01
USE_PROCD=1

CONFIG="h3c_auth"
SCRIPT="/usr/lib/h3c-auth/h3c-auth.sh"
PID_FILE="/tmp/h3c-auth/auth.pid"

start_service() {
    config_load "$CONFIG"
    config_foreach start_auth_instance auth
}

start_auth_instance() {
    local section="$1"
    local enabled
    config_get_bool enabled "$section" enabled 0

    [ "$enabled" -eq 1 ] || return 0

    procd_open_instance "h3c_auth_${section}"
    procd_set_param command "$SCRIPT" start "$section"
    procd_set_param respawn 3600 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PID_FILE"
    procd_close_instance
}

stop_service() {
    "$SCRIPT" stop
}

reload_service() {
    stop_service
    start_service
}

service_triggers() {
    procd_add_reload_trigger "$CONFIG"
    procd_add_network_trigger "wan"
    procd_add_network_trigger "wan6"
}
